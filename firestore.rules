rules_version = '2';

/* ============================================================
   R2200 SiteTrack — Firestore security rules
   ------------------------------------------------------------
   SIGN-IN MODEL — a name and a password, nothing else.

   People type only their NAME. Firebase Auth still needs an address, so
   `loginDomain` in firebase-config.js completes one behind the scenes:

       nanda    ->  nanda@r2200.local
       Ahmed K  ->  ahmed.k@r2200.local        (a space becomes a dot)

   The domain never has to exist and no mail is ever sent. That completed
   address is three things at once, and they must match exactly:
     · the account in Console -> Authentication -> Users
     · the profile document id at users/{name@r2200.local}
     · request.auth.token.email, which these rules match on

   Every account MUST have a profile document, written by the planner in
   the app (Setup -> Users). The profile carries the role. Signed in with
   no profile = access to nothing. That is deliberate, not a fault.

   Roles:  planner  — full control, incl. baseline + user list
           engineer — reads everything, writes site records
           viewer   — read-only

   PASTE THIS in Firebase Console -> Firestore Database -> Rules -> Publish.
   Do NOT leave the default "test mode" rules in place: they allow the
   whole internet to read and write this project.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- who is asking ----------
       Password sign-in ONLY. The provider check rejects anonymous, Google,
       phone and custom-token sessions outright, so nothing but a name and
       a password can reach any document — even if another provider is
       switched on in the console by mistake.

       One caveat worth knowing: passwordless "Email link" sign-in also
       reports itself as 'password', so rules cannot tell it apart. Leave
       Email link DISABLED in Console -> Authentication -> Sign-in method
       (the setup guide already says to). That console switch is the only
       control for it.

       Do NOT add an email_verified check here. These addresses are on a
       domain that does not exist, no verification mail can ever arrive,
       and requiring it would lock out every account including yours. */
    function signedIn() {
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    /* the completed address, lower-cased — the profile document id */
    function myKey() {
      return request.auth.token.email.lower();
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(myKey())).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(myKey()));
    }
    function role() {
      return hasProfile() ? profile().role : 'none';
    }
    function isPlanner()  { return role() == 'planner'; }
    function canWrite()   { return role() == 'planner' || role() == 'engineer'; }
    function canRead()    { return hasProfile(); }

    /* A record must not claim a rev far in the future (clock-skew /
       tampering guard: 1 day ahead of the server). Records are
       last-write-wins on rev, so an absurd rev would pin a value. */
    function revSane() {
      return request.resource.data.rev is number
             && request.resource.data.rev < request.time.toMillis() + 86400000;
    }

    /* ---------- user profiles ---------- */
    /* Anyone signed in may read their OWN profile (the app needs it to
       learn its role at sign-in). The planner may read and write all.

       A profile is the thing that grants access, so it is validated:
       the document id must be the lower-case completed address, the
       `email` field must repeat it, and the role must be one the app
       understands. That stops a typo or a stray capital creating a
       profile that silently never matches anyone's sign-in. */
    function profileSane(id) {
      return id == id.lower()
             && request.resource.data.email == id
             && request.resource.data.role in ['planner', 'engineer', 'viewer'];
    }
    match /users/{loginId} {
      allow read:   if signedIn() && (loginId == myKey() || isPlanner());
      allow create,
            update: if isPlanner() && profileSane(loginId);
      allow delete: if isPlanner();
      /* BOOTSTRAP — the first planner profile.
         These rules let only a planner write profiles, and before the
         first one exists nobody is a planner. Create that ONE document by
         hand in Console -> Firestore -> Data (console writes bypass rules
         entirely, so nothing here has to be loosened):
             collection  users
             document id nanda@r2200.local     <- the full completed address
             email       nanda@r2200.local     <- the same string again
             name        Nanda
             role        planner
             areas       []                    (empty array)
             rev         1
         Everyone else is added from inside the app, Setup -> Users. */
    }

    /* ---------- site records ---------- */
    match /{store}/{docId} {
      allow read: if canRead()
                  && store in ['progress', 'diary', 'event', 'ir', 'photos'];
      allow create, update: if canWrite()
                  && store in ['progress', 'diary', 'event', 'ir', 'photos']
                  && revSane();
      /* Nothing is ever hard-deleted — the app voids records instead, so
         the audit trail survives. Deletes are refused for everyone. */
      allow delete: if false;
    }

    /* ---------- baseline distribution ---------- */
    /* Everyone signed in reads the baseline; only the planner replaces it. */
    match /meta/{docId} {
      allow read:  if canRead();
      allow write: if isPlanner();
    }
    match /baselineChunks/{chunkId} {
      allow read:  if canRead();
      allow write: if isPlanner();
    }

    /* ---------- default deny ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/* ============================================================
   OPTIONAL — lock sign-in to the project domain
   ------------------------------------------------------------
   The rules above accept any password account that has a profile. To also
   refuse anything outside r2200.local, add this line to signedIn():

       && request.auth.token.email.lower().matches('.*@r2200[.]local')

   Only do that while `loginDomain` is set in firebase-config.js. The
   setup guide says you may delete that line to go back to real email
   addresses — with the domain lock published, doing so locks out every
   account including your own, and the only way back is the console.
   ============================================================ */
